{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run typecheck)",
      "Bash(npm run balance)",
      "Bash(npm run balance *)",
      "Bash(npx vitest *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./docs/specs/*.pdf)",
      "Edit(./docs/specs/*.xlsx)"
    ]
  }
}
